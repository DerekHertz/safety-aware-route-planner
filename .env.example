# Copy to `.env` and adjust. Every variable is optional — the defaults in
# config/config.toml are what the app uses when these are unset.
#
# This file documents the variables that exist TODAY. Deployment-related ones
# (pack fetching, CORS from env, multi-region selection) arrive with the
# hosting work and will be added here then.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# Path to the TOML config. Default: config/config.toml
# Read by api/main.py and api/state.py.
#SR_CONFIG=config/config.toml

# Path to ONE pack directory, overriding <api.pack_dir>/<region.active>.
# Note this points at a specific pack (the directory containing manifest.json),
# not at the directory of packs. The API test suite uses it to point at a
# generated toy pack.
#SR_PACK_DIR=data/packs/berkeley_oakland

# Public base URL of the bucket holding prebuilt packs, overriding `base_url`
# in packs.lock. Must end in a slash. When neither is set, pack fetching is
# disabled and the API reads local disk only (the local-dev default).
# No credentials: packs derive from public OpenStreetMap data, so the bucket is
# public-read and only CI — which uploads — needs keys.
#SR_PACKS_URL=https://packs.example.com/

# Path to the pack lock file. Default: packs.lock at the repo root.
#SR_PACKS_LOCK=packs.lock

# Comma-separated allowed CORS origins, overriding [api] cors_origins in
# config/config.toml. The deployed front-end is on a different origin from the
# API and that origin is not knowable at commit time, so it comes from here.
#SR_CORS_ORIGINS=https://myapp.vercel.app,https://myapp.com

# Regex for hosts that mint a new domain per deployment (preview builds), which
# a static list can never match.
#
# ANCHOR IT to your own project and scope. `https://.*\.vercel\.app` would
# match every site anyone has ever deployed to Vercel — that is, it grants the
# entire platform access to your API.
#SR_CORS_ORIGIN_REGEX=^https://myproject-[a-z0-9-]+-myscope\.vercel\.app$

# Full User-Agent sent to Nominatim. Their usage policy requires a UA that
# identifies the application and gives a way to reach whoever runs it.
# Set this per-deployment so a personal contact never lands in version control.
# Default: the project URL in config/config.toml.
#SR_NOMINATIM_CONTACT=safety-aware-route-planner/0.1 (+https://example.com)

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

# Relax the Python<->C++ parity assertion from bitwise-equal to 1e-9.
# For LOCAL DIAGNOSIS ONLY — never set this in CI. Bitwise equality is the
# design premise of this codebase (see tests/test_parity_cpp.py); if the two
# engines diverge, fix the compiler flags in core/setup.py, don't loosen the
# assertion.
#SR_PARITY_LOOSE=1
