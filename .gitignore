.venv/
__pycache__/
*.pyc
data/
web/node_modules/
web/.next/
# Regenerated from node_modules by web/scripts/copy-maplibre-worker.mjs
# on predev/prebuild — don't vendor a second copy into git.
web/public/maplibre/
core/build/
*.pyd
*.egg-info/
.pytest_cache/
.env
.env.*
!.env.example

# Per-machine Claude Code permission allowlist. It accumulates absolute
# scratchpad paths (C:\Users\<you>\AppData\Local\Temp\...) and session UUIDs,
# which are noise at best and a small personal-info leak at worst.
# .claude/launch.json IS tracked on purpose — it is shared project config.
.claude/settings.local.json
