# Copy to `.env.local` for local overrides.

# Base URL of the FastAPI backend. Default when unset: http://localhost:8000
#
# NEXT_PUBLIC_* is inlined at BUILD time, not read at runtime — changing this
# requires a rebuild, and on a hosting provider it is a build-time environment
# variable, not a runtime one.
#
# Must be https:// for any deployed build. A page served over https cannot
# fetch an http:// API (mixed content), and the failure is silent apart from a
# console error.
NEXT_PUBLIC_API_URL=http://localhost:8000
